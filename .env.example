##### YOUTUBE
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

##### SNOWFLAKE
# Account identifier in <ORG>-<ACCOUNT_NAME> form (SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();)
SNOWFLAKE_ACCOUNT=MYORG-MYACCOUNT
# Must be the user's LOGIN_NAME (DESCRIBE USER <name>), NOT the user object name.
SNOWFLAKE_USER=YOUR_LOGIN_NAME
SNOWFLAKE_ROLE=YOUTUBE_INGEST_ROLE
SNOWFLAKE_WAREHOUSE=YOUTUBE_INGEST_WH
SNOWFLAKE_DATABASE=YOUTUBE_DB
SNOWFLAKE_SCHEMA=RAW
# Path to PKCS#8 PEM private key (relative paths resolve from the project root)
SNOWFLAKE_PRIVATE_KEY_PATH=snowflake_private_key.p8
# Only needed if the private key is encrypted
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
