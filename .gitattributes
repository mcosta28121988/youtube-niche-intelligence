# Normalise line endings: LF in the repository and in working copies, so
# files are identical on Windows, CI (Linux) and in Snowflake worksheets.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pbix binary
*.pbit binary
*.xlsx binary
*.parquet binary
